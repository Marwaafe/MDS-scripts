library(Seurat)
library(tidyverse)
library(symphony)
library(ggpubr)
library(patchwork)
library(BoneMarrowMap)


# Set directory to store projection reference files
projection_path <- "/trinity/home/mafechkar/BoneMarrowMap_ref/"

# Create the folder if it doesn't exist
if (!dir.exists(projection_path)) dir.create(projection_path)

# Download Bone Marrow Reference - 344 Mb
curl::curl_download('https://bonemarrowmap.s3.us-east-2.amazonaws.com/BoneMarrowMap_SymphonyReference.rds', 
                    destfile = paste0(projection_path, 'BoneMarrowMap_SymphonyReference.rds'))
# Download uwot model file - 221 Mb
curl::curl_download('https://bonemarrowmap.s3.us-east-2.amazonaws.com/BoneMarrowMap_uwot_model.uwot', 
                    destfile = paste0(projection_path, 'BoneMarrowMap_uwot_model.uwot'))

# Load Symphony reference
ref <- readRDS(paste0(projection_path, 'BoneMarrowMap_SymphonyReference.rds'))
# Set uwot path for UMAP projection
ref$save_uwot_path <- paste0(projection_path, 'BoneMarrowMap_uwot_model.uwot')


GetAssayData(merged_Healthy_log.harmony, assay = "RNA", slot = "counts")

# Map query dataset using Symphony 
query_healthy <- map_Query(
  exp_query = GetAssayData(merged_Healthy_log.harmony, assay = "RNA", slot = "counts"),
  metadata_query = merged_Healthy_log.harmony@meta.data,
  ref_obj = ref,
  vars = "orig.ident"  # or your batch/sample column
)

# Run QC based on mapping error score, flag cells with mapping error >= 2.5 MADs above median
query_healthy <- calculate_MappingError(query_healthy, reference = ref, MAD_threshold = 2.5)
plot_MappingErrorQC(query_healthy)

# Predict Hematopoietic Cell Types by KNN classification
query_healthy <- predict_CellTypes(query_obj = query_healthy, ref_obj = ref, final_label = "predicted_CellType")


merged_Healthy_log.harmony$predicted_CellType <- query_healthy$predicted_CellType
library(ggplot2)
library(ggrepel)


library(dittoSeq)

BoneMarrowMap_Annotation <- dittoDimPlot(
  merged_Healthy_log.harmony,
  var = "predicted_CellType",
  do.label = TRUE,
  labels.size = 4,
  reduction.use = "umap",
  color.panel = distinct_colors,
  show.grid.lines = TRUE,
  shape.legend.size = 3,
  size = 0.5,
  do.ellipse = FALSE,
  legend.title = "",
  legend.size = 4,
  dim.1 = 1,
  dim.2 = 2
) +
  ggtitle("Healthy Donors Annotated with BoneMarrowMap") +
  theme(
    plot.title = element_text(size = 10, face = "bold"),
    legend.text = element_text(size = 8),
    aspect.ratio = 1
  ) +
  xlab("UMAP1") +
  ylab("UMAP2")

