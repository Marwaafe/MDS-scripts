library(Seurat)
library(pheatmap)
library(dplyr)
# Step 1: Identify markers
markers_MDS <- FindAllMarkers(
  merged_seurat_log.harmony,
  min.pct = 0.2,
  min.diff.pct = 0.2,
  only.pos = TRUE,
  verbose = TRUE,
  slot = "data"
)
# Step 2: Select top 5 markers per cluster by average log2FC, logFC is good to see effect size.
top10 <- markers_MDS %>%
  group_by(cluster) %>%
  top_n(n =10 , wt= avg_log2FC)
top10
# averaging the expression
avg_expr <- AverageExpression(merged_seurat_log.harmony, assays = "RNA", layer = "data", features = unique(top10$gene))$RNA
# scale across clusters for heatmap contrast
avg_expr <- t(scale(t(avg_expr)))
# Plot
pheatmap(
  mat = avg_expr,
  cluster_rows = T,
  cluster_cols = T,treeheight_row = 10, treeheight_col = 10,
  fontsize = 7, angle_col = 45,colorRampPalette(c("lightblue", "white", "red"))(100),
  main = "Top 5 Marker Genes per Cluster"
)



