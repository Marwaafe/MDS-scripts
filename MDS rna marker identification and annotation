all.genes <- rownames(merged_seurat_log.harmony)

#Remove immunoglobulin genes from your HVGs before PCA:
ig_genes <- grep("^IG[HKL]", VariableFeatures(merged_seurat_log.harmony), value = TRUE)
VariableFeatures(merged_seurat_log.harmony) <- setdiff(VariableFeatures(merged_seurat_log.harmony), ig_genes)

merged_seurat_log.harmony <- ScaleData(merged_seurat_log.harmony, features = all.genes)
